{
  "name": "portfolio-dashboard-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express backend that serves live portfolio data, fetching CMP from Yahoo Finance and P/E + earnings from Google Finance",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "5.9.3"
  }
}
